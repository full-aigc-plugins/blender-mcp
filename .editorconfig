root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.py]
indent_style = space
indent_size = 4

# Guides use trailing double spaces for hard line breaks in Markdown.
[*.md]
trim_trailing_whitespace = false

[*.{yml,yaml,json,toml}]
indent_style = space
indent_size = 2

[*.ps1]
indent_style = space
indent_size = 4
end_of_line = crlf

[*.bat]
end_of_line = crlf
